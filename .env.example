# ==========================================
# Zepto Quick Scan Bot Configuration (.env)
# ==========================================

# Telegram Bot Credentials (Required for Telegram alerts)
# 1. Create a bot via @BotFather on Telegram to get your token
# 2. Get your Chat ID from @userinfobot or @raw_data_bot on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Quick Scan Filter Parameters
# Max price in rupees (default: 100 for Quick Scan < 100rs)
MAX_PRICE=100

# Pages to fetch per category (<= 2 pages, e.g. 2)
PAGES_PER_CATEGORY=2

# Minimum discount percent threshold (e.g. 50 for 50%+ off)
MIN_DISCOUNT_PERCENT=50

# Link text on Telegram (e.g. Buy on Zepto ⚡️ or Buy on Blinkit ⚡️)
STORE_LINK_TEXT=Buy on Zepto ⚡️

# Delivery Location Coordinates (Optional, defaults to Central Bengaluru fallback)
# Right-click your delivery location on Google Maps to copy latitude and longitude
USER_LATITUDE=12.9716
USER_LONGITUDE=77.5946
