# ==========================================
# Zepto Deals Bot Configuration (.env)
# ==========================================

# Telegram Bot Alerts (Required if using Telegram)
# 1. Create a bot via @BotFather on Telegram to get your token
# 2. Get your Chat ID from @userinfobot or @raw_data_bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# Discord Webhook Alerts (Optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Your Delivery Location Coordinates (Optional, defaults to central Bengaluru)
# Find your coordinates on Google Maps by right-clicking on your location
USER_LATITUDE=12.9716
USER_LONGITUDE=77.5946

# Filter Thresholds (Optional)
MIN_DISCOUNT_PERCENT=70
MAX_PAGES_PER_SUBCAT=15
